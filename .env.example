# ─────────────────────────────────────────────────────────────
# rewear – Umgebungsvariablen
# Kopiere diese Datei nach .env und trage deine Werte ein.
# Nichts davon gehört ins Git-Repository.
# ─────────────────────────────────────────────────────────────

# Öffentliche Adresse des Shops (ohne / am Ende). Pflicht in Produktion.
SITE_URL=https://www.rewear.de

# Stripe (https://dashboard.stripe.com/apikeys)
# Ohne Schlüssel läuft der Shop im Demo-Modus: „Zur Kasse“ zeigt einen Hinweis statt zu bezahlen.
STRIPE_SECRET_KEY=sk_test_...
# Signatur-Geheimnis des Webhooks für /api/stripe-webhook (Event: checkout.session.completed)
STRIPE_WEBHOOK_SECRET=whsec_...
# „true“, sobald im Stripe-Dashboard unter Einstellungen → Public details die AGB-URL hinterlegt ist.
# Dann muss die Kundschaft im Checkout die AGB aktiv bestätigen.
STRIPE_REQUIRE_TERMS=false

# E-Mail-Versand per SMTP (z. B. vom Hoster deiner Domain)
# Wird gebraucht für: Kontaktformular, Verkaufsanfragen, Widerrufe, Bestellbestätigungen.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=hallo@rewear.de
SMTP_PASS=
# Absender und Empfänger der Shop-Mails
MAIL_FROM="rewear <hallo@rewear.de>"
MAIL_TO=hallo@rewear.de

# Newsletter mit Double-Opt-in über Brevo (optional – ohne diese Werte wird das Newsletter-Formular ausgeblendet)
BREVO_API_KEY=
BREVO_LIST_ID=
BREVO_DOI_TEMPLATE_ID=
